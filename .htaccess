# Header keamanan untuk SEMUA respons, termasuk file statis (wp-content/uploads, CSS, JS) yang tidak
# lewat PHP. Untuk respons dari CodeIgniter, header yang sama juga dipasang oleh
# application/hooks/Security_headers.php — di sana ada penjelasan kenapa object-src & script-src tidak
# dibatasi, dan kenapa HSTS tidak boleh memakai includeSubDomains. "set" menimpa, jadi tidak dobel.
# Catatan: nginx mengabaikan file ini; di nginx, aturan ini harus ditulis ulang di konfigurasi server.
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "SAMEORIGIN"
	Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'"
	Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

	# Aktifkan HANYA setelah seluruh situs berjalan di HTTPS. Jangan tambahkan includeSubDomains
	# sebelum semua subdomain (jarvis, lib, ppid, e-learning, ...) juga HTTPS.
	# Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Folder referensi clone tidak ikut dipublikasikan (seharusnya memang tidak ikut di-deploy; ini jaring pengaman)
	RewriteRule ^stmi\.ac\.id-clone(/|$) - [F,L]

	# Repositori git (.git/, .gitignore, ...): riwayatnya memuat seluruh source code dan kredensial lama.
	# Apache bawaan hanya menolak .ht*, jadi tanpa aturan ini /.git/config bisa diunduh kalau situs
	# di-deploy dengan git clone langsung ke docroot.
	RewriteRule (^|/)\.git - [F,L]

	# File/folder yang ada (aset wp-content, wp-includes) dilayani langsung
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
	ErrorDocument 404 /index.php
</IfModule>
