# Port Nginx di Host (Gunakan 80 untuk VPS produksi, atau 8080 untuk tes lokal)
WEB_PORT=80

# Domain & Base URL CodeIgniter (Wajib diakhiri garis miring '/')
CI_BASE_URL=https://worksblue.my.id/
CI_ENV=production

# Database Configuration
DB_NAME=lpstmi_db
DB_USER=lpstmi_app
DB_PASS=GantiDenganPasswordAman123!
DB_ROOT_PASSWORD=GantiDenganRootPasswordAman456!

# Otomatis isi seed saat pertama kali database dibuat (true / false)
AUTO_SEED=true

# Username admin pertama untuk skrip setup.sh
ADMIN_USERNAME=admin

