# ========================================================
# ENVIRONMENT CONFIGURATION: LOCAL DEVELOPMENT
# ========================================================

# Port Nginx di Host (Gunakan 80 atau 8080 jika port 80 bentrok)
WEB_PORT=80

# Base URL CodeIgniter untuk Pengujian Lokal (Wajib diakhiri '/')
CI_BASE_URL=http://localhost/
CI_ENV=development

# Database Configuration
DB_NAME=lpstmi_db
DB_USER=lpstmi_app
DB_PASS=secretpassword
DB_ROOT_PASSWORD=rootsecret

# Otomatis isi seed saat pertama kali database dibuat (true / false)
AUTO_SEED=true

# Username admin pertama untuk skrip setup.sh
ADMIN_USERNAME=admin
