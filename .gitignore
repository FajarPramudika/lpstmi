.env
.env.*
!.env.example
application/config/database.local.php
security-audit.md
security-fix.md

# ========================================================
# Cache & Sesi Aplikasi
# ========================================================
application/cache/*
!application/cache/index.html
application/cache/sessions/*
!application/cache/sessions/index.html
application/cache/ratelimit/*
!application/cache/ratelimit/index.html

# ========================================================
# Log Harian & Runtime Logs
# ========================================================
application/logs/*
